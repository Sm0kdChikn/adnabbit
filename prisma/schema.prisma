// AdNabbit MVP — SQLite by default for zero-setup local demos.
// To switch to Postgres: change provider to "postgresql" and set DATABASE_URL
// e.g. postgresql://user:pass@localhost:5432/adnabbit
//
// Note: SQLite has no native enums — Role, status, vertical, inventoryStatus are strings.
// Valid Role: ADVERTISER | ADMIN | HOST
// Valid Creative status: DRAFT | PENDING | APPROVED | REJECTED
// Valid PlacementRequest status: REQUESTED | APPROVED | REJECTED
// Valid HostVertical: see src/lib/types.ts
// Valid InventoryStatus: OPEN | LIMITED | FULL
// Valid Schedule status: DRAFT | ACTIVE | ENDED | CANCELLED
// Valid Schedule kind: ONE_OFF | RECURRING
// Ticket J: Device (1:1 Screen) + ScreenClaim one-time codes
// Ticket K: AdminFolder / AdminFolderItem (HOST|ADVERTISER scope)
// Ticket O: Device.playlistEpoch for force playlist refresh
// Ticket P: Device.screenshotEpoch + remote-view JPEG overwrite
// Ticket P.1: Device.pendingInputJson remote mouse/keyboard queue
// Ticket Q: OpenHours + Screen.useCustomHours/forceLiveUntil + Device.playbackState
// Ticket R: FleetAlert + Device.playerVersion/disk* for fleet health
// Ticket S: Creative/User/Host/Screen take-down stamps; Schedule windows already Ticket E
// Ticket T: analytics from OpenHours + schedule expansion (no PlayEvent invent)
// Ticket U: DownloadHours (host quiet hours) + admin fleet bulk ops
// Ticket V: Host.offlinePolicy + offlineCacheTtlHours (player offline play)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                    String             @id @default(cuid())
  email                 String             @unique
  passwordHash          String
  name                  String?
  /// ADVERTISER | ADMIN | HOST
  role                  String             @default("ADVERTISER")
  creatives             Creative[]
  profile               AdvertiserProfile?
  /// Ticket G — optional 1:1 owning login for a Host (HOST role)
  host                  Host?
  placementRequests     PlacementRequest[] @relation("PlacementAdvertiser")
  reviewedPlacements    PlacementRequest[] @relation("PlacementReviewer")
  schedulesCreated      Schedule[]         @relation("ScheduleCreator")
  playImports           PlayImport[]
  /// Ticket S — admin emergency take-down of all this advertiser's creatives from playlists
  advertiserTakenDownAt     DateTime?
  advertiserTakenDownById   String?
  advertiserTakenDownReason String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
}

model Creative {
  id                String             @id @default(cuid())
  name              String
  notes             String?
  fileName          String
  storedName        String
  mimeType          String
  fileSize          Int
  status            String             @default("DRAFT")
  rejectReason      String?
  advertiserId      String
  advertiser        User               @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  reviewedAt        DateTime?
  /// Ticket S — admin emergency take-down (null = clear / playing if approved + in window)
  takenDownAt       DateTime?
  takenDownById     String?
  takenDownReason   String?
  placementRequests PlacementRequest[]
  playEvents        PlayEvent[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([takenDownAt])
}

/// Venue / host location. Screens inherit vertical from Host (not stored on Screen).
model Host {
  id         String   @id @default(cuid())
  name       String
  /// Primary vertical (HostVertical enum as string)
  vertical   String
  /// Required when vertical is OTHER
  otherLabel String?
  /// IANA timezone; screens inherit for daypart scheduling (Ticket E)
  timezone   String   @default("America/Denver")
  /// Ticket V — PLAY_CACHE | BLACKOUT when API unreachable / no heartbeat within grace
  offlinePolicy         String   @default("PLAY_CACHE")
  /// Ticket V — hours to keep looping last cached playlist (0 = blackout immediately when offline)
  offlineCacheTtlHours  Int      @default(24)
  notes      String?
  /// Ticket G — owning HOST user (null = unclaimed). One login owns one Host for MVP.
  userId     String?  @unique
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  screens    Screen[]
  /// Ticket S — soft kill: empty paid playlists for all screens under this host
  playbackTakenDownAt     DateTime?
  playbackTakenDownById   String?
  playbackTakenDownReason String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Screen {
  id                String             @id @default(cuid())
  name              String
  city              String
  zip               String
  /// OPEN | LIMITED | FULL
  inventoryStatus   String             @default("OPEN")
  notes             String?
  hostId            String
  host              Host               @relation(fields: [hostId], references: [id], onDelete: Cascade)
  placementRequests PlacementRequest[]
  schedules         Schedule[]
  device            Device?
  claims            ScreenClaim[]
  /// Ticket Q — when true, use SCREEN-scoped OpenHours instead of Host venue hours
  useCustomHours    Boolean            @default(false)
  /// Ticket Q — admin force-live override until Instant (bypasses closed hours)
  forceLiveUntil    DateTime?
  /// Ticket S — soft kill: empty paid playlist for this screen
  playbackTakenDownAt     DateTime?
  playbackTakenDownById   String?
  playbackTakenDownReason String?
  /// Ticket R — fleet health alerts
  fleetAlerts       FleetAlert[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([city])
  @@index([zip])
  @@index([inventoryStatus])
  @@index([hostId])
}

/// Ticket B — public advertiser profile (1:1 with User)
model AdvertiserProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// URL-safe unique slug for /a/[slug]
  slug            String   @unique
  displayName     String
  pitch           String?
  website         String?
  /// Phone or email contact
  contact         String?
  /// Uploaded logo file under uploads/
  logoStoredName  String?
  /// External logo URL (alternative to upload)
  logoUrl         String?
  category        String?
  /// Comma/space-separated ZIP codes or free-form service area
  serviceAreaZips String?
  published       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([published])
}

/// Ticket C — advertiser requests placement of an APPROVED creative on a screen
model PlacementRequest {
  id             String    @id @default(cuid())
  advertiserId   String
  advertiser     User      @relation("PlacementAdvertiser", fields: [advertiserId], references: [id], onDelete: Cascade)
  screenId       String
  screen         Screen    @relation(fields: [screenId], references: [id], onDelete: Cascade)
  creativeId     String
  creative       Creative  @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  /// REQUESTED | APPROVED | REJECTED
  status         String    @default("REQUESTED")
  rejectReason   String?
  /// Optional message from advertiser when requesting
  note           String?
  reviewedAt     DateTime?
  reviewedById   String?
  reviewedBy     User?     @relation("PlacementReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  schedules      Schedule[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([advertiserId])
  @@index([screenId])
  @@index([creativeId])
}

/// Ticket D/E — schedule a window or recurring daypart for an APPROVED PlacementRequest
model Schedule {
  id           String           @id @default(cuid())
  placementId  String
  placement    PlacementRequest @relation(fields: [placementId], references: [id], onDelete: Cascade)
  /// Cached from placement.screenId for same-screen overlap queries / filters
  screenId     String
  screen       Screen           @relation(fields: [screenId], references: [id], onDelete: Cascade)
  /// ONE_OFF | RECURRING (Ticket E)
  kind         String           @default("ONE_OFF")
  /// ONE_OFF absolute window (nullable for RECURRING)
  startAt      DateTime?
  endAt        DateTime?
  /// RECURRING: ISO weekdays Mon=1..Sun=7 as CSV e.g. "1,2,3,4,5"
  weekdays     String?
  /// RECURRING daypart HH:mm in host timezone (same-day, endTime > startTime; no overnight)
  startTime    String?
  endTime      String?
  /// RECURRING campaign date range YYYY-MM-DD (end >= start)
  campaignStartDate String?
  campaignEndDate   String?
  /// DRAFT | ACTIVE | ENDED | CANCELLED
  status       String           @default("DRAFT")
  note         String?
  createdById  String
  createdBy    User             @relation("ScheduleCreator", fields: [createdById], references: [id], onDelete: Cascade)
  cancelledAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status])
  @@index([kind])
  @@index([startAt])
  @@index([endAt])
  @@index([campaignStartDate])
  @@index([campaignEndDate])
  @@index([placementId])
  @@index([screenId])
}

/// Ticket F — OptiSigns proof-of-play CSV import batch
model PlayImport {
  id            String      @id @default(cuid())
  uploadedById  String
  uploadedBy    User        @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  filename      String
  rowCount      Int
  insertedCount Int
  skippedDupes  Int
  importedAt    DateTime    @default(now())
  notes         String?
  events        PlayEvent[]
}

/// Ticket F — one OptiSigns play / proof-of-play row
model PlayEvent {
  id              String      @id @default(cuid())
  importId        String?
  import          PlayImport? @relation(fields: [importId], references: [id], onDelete: SetNull)
  reportDateUtc   DateTime
  accountId       String?
  screenUuid      String
  screenName      String
  screenTags      String
  assetId         String
  assetName       String
  assetTags       String?
  startTimeUtc    DateTime
  /// OptiSigns "Device Local Time" — per Brandon this is IANA timezone string, not wall clock
  deviceLocalTime String
  /// Parsed IANA timezone if deviceLocalTime looks like one; otherwise null
  deviceTimezone  String?
  durationSec     Int
  creativeId      String?
  creative        Creative?   @relation(fields: [creativeId], references: [id], onDelete: SetNull)
  /// Host/internal filler (not advertiser paid play). See isHostFillerFromCsv in lib/pop.ts
  isHostFiller    Boolean     @default(false)
  /// sha256 of screenUuid|assetId|startTimeUtcISO|durationSec — unique for dedupe
  rawHash         String      @unique
  createdAt       DateTime    @default(now())

  @@index([startTimeUtc])
  @@index([screenUuid])
  @@index([assetId])
  @@index([creativeId])
  @@index([isHostFiller])
  @@index([importId])
}

/// Ticket J — paired kiosk player device (1 per Screen for spike; reclaim replaces)
/// Ticket O — playlistEpoch bumped by admin/host refresh; player compares and re-fetches
/// Ticket P — screenshotEpoch for admin remote-view capture; single overwrite JPEG blob
/// Ticket P.1 — pendingInputJson queue for admin remote mouse/keyboard
/// Ticket Q — playbackState for closed-hours / idle / live status
/// Ticket R — playerVersion + optional disk stats from heartbeat
model Device {
  id            String    @id @default(cuid())
  /// Unique: one Device bound per Screen
  screenId      String    @unique
  screen        Screen    @relation(fields: [screenId], references: [id], onDelete: Cascade)
  /// sha256 hex of device bearer token (never store raw token)
  tokenHash     String    @unique
  name          String?
  lastSeenAt    DateTime?
  claimedAt     DateTime  @default(now())
  /// Ticket O — monotonic counter; bump to force player playlist re-fetch
  playlistEpoch Int       @default(0)
  /// Ticket P — bumped when admin requests a capture; player compares on heartbeat
  screenshotEpoch Int     @default(0)
  /// Ticket P — last epoch the device successfully uploaded a screenshot for
  screenshotCapturedEpoch Int @default(0)
  /// Relative path under uploads/ e.g. device-previews/{deviceId}.jpg (overwrite N=1)
  remoteViewImagePath String?
  remoteViewCapturedAt DateTime?
  /// Ticket P.1 — JSON array of pending remote input events; drained by player poll/heartbeat
  pendingInputJson String?
  /// Ticket Q — last player-reported state: LIVE | BLACKOUT | IDLE | EMPTY
  playbackState   String?
  playbackStateAt DateTime?
  /// Ticket R — semver/string from player package (heartbeat)
  playerVersion   String?
  /// Ticket R — optional disk stats (bytes); null until player reports (no fake metrics)
  diskFreeBytes   Int?
  diskTotalBytes  Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([lastSeenAt])
}

/// Ticket J — one-time claim codes to pair a player to a Screen
model ScreenClaim {
  id          String    @id @default(cuid())
  screenId    String
  screen      Screen    @relation(fields: [screenId], references: [id], onDelete: Cascade)
  /// 6–8 chars from A–Z0–9 excluding 0O1I
  code        String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([screenId])
  @@index([expiresAt])
}

/// Ticket K — admin-only organizational folders (HOST or ADVERTISER scope)
model AdminFolder {
  id        String            @id @default(cuid())
  /// HOST | ADVERTISER
  scope     String
  name      String
  sortOrder Int               @default(0)
  items     AdminFolderItem[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([scope, sortOrder])
}

/// Membership of a Host or Advertiser user in one AdminFolder (at most one folder)
model AdminFolderItem {
  id         String      @id @default(cuid())
  folderId   String
  folder     AdminFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  /// HOST | ADVERTISER — must match folder.scope
  targetType String
  /// Host.id or User.id (role ADVERTISER)
  targetId   String
  sortOrder  Int         @default(0)

  @@unique([targetType, targetId])
  @@index([folderId, sortOrder])
}

/// Ticket Q — weekly open hours for a Host (venue) or Screen override
/// Missing weekday row or null open/close = closed that day.
/// No rows at all for the effective scope = always open (legacy default).
model OpenHours {
  id        String   @id @default(cuid())
  /// HOST | SCREEN
  scope     String
  /// Host.id or Screen.id
  targetId  String
  /// ISO weekday Mon=1 .. Sun=7
  weekday   Int
  /// HH:mm open (null with null close = closed all day)
  openTime  String?
  /// HH:mm close; same-day only (end > start). Overnight = TODO.
  closeTime String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scope, targetId, weekday])
  @@index([scope, targetId])
}

/// Ticket R — in-app fleet alert (one OPEN per screen+kind until resolved)
model FleetAlert {
  id         String    @id @default(cuid())
  screenId   String
  screen     Screen    @relation(fields: [screenId], references: [id], onDelete: Cascade)
  /// OFFLINE | EMPTY
  kind       String
  /// OPEN | RESOLVED
  status     String    @default("OPEN")
  message    String?
  openedAt   DateTime  @default(now())
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status])
  @@index([kind])
  @@index([screenId, kind, status])
  @@index([openedAt])
}

/// Ticket U — weekly download / quiet hours for a Host (venue).
/// Empty/null rows for host = allow downloads anytime (legacy-safe).
/// Outside window: player plays from cache only; defers prefetch.
/// Soft miss: per-screen override / bandwidth caps (not in MVP).
model DownloadHours {
  id        String   @id @default(cuid())
  /// HOST only for MVP (SCREEN soft miss)
  scope     String
  /// Host.id
  targetId  String
  /// ISO weekday Mon=1 .. Sun=7
  weekday   Int
  /// HH:mm window start when downloads are allowed (null+null close = no download that day)
  openTime  String?
  /// HH:mm window end; same-day only (end > start)
  closeTime String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scope, targetId, weekday])
  @@index([scope, targetId])
}
